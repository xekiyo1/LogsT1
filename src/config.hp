#ifndef CONFIG_HP
#define CONFIG_HP

/// Tamaño esperado de un bloque.
#define BLOCK 4096 //se asume potencia de 2 o si no los mataré a todos
/// Cantidad de puntos float que caben en un bloque.
#define FLOAT_BLOCK (int) (BLOCK/sizeof(float))
/// Cantidad máxima de Hijos que puede contener un Nodo del RTree.
#define HIJOS_NODO 204
/// Tamaño sobrante del bloque al escribir un Nodo.
#define PAD_SIZE 12
/// Tamaño asumido de memoria @deprecated
#define MEMORY_SIZE 0
/// Nivel de detalle para DEBUG, que se utiliza para decidir cuándo imprimir y cuándo no.
#define LOGLEVEL (int) 1
/// Cantidad de queries que se realizan en las iteraciones de prueba @see main/treeQueries.cpp
#define CUADRADOS 100

/// Exponente mínimo al decidir cuántos puntos extraer de un archivo.
#define MIN_2N 15
/// Exponente máximo de dos que indica cuántos puntos se extraerán de los archivos.
#define MAX_2N 24

/**
 * Estructura que representa una query para un RTree. Contiene las coordenadas que corresponden al bounding box que
 * se está consultando. Se llama Square pues se utiliza para generar cuadrados, pero puede ser un rectángulo sin problema.
 */
struct QuerySquare {
    /// Cota inferior del rectángulo en el eje X.
    float x1;
    /// Cota inferior del rectángulo en el eje Y.
    float y1;
    /// Cota superior del rectángulo en el eje X.
    float x2;
    /// Cota superior del rectángulo en el eje Y.
    float y2;
};

/** Estructura que representa un hijo dentro de un nodo. Incluye el rectángulo que contiene a sus puntos y el
 * índice del archivo donde se almacena el nodo en sí.*/
struct Hijo{
    /// Cota inferior del rectángulo en el eje X.
    float x1;
    /// Cota inferior del rectángulo en el eje Y.
    float y1;
    /// Cota superior del rectángulo en el eje X.
    float x2;
    /// Cota superior del rectángulo en el eje Y.
    float y2;
    /// Índice donde está almacenado el Nodo con estas coordenadas.
    int valor;
};

/**
 * Estructura del Nodo de un RTree, que representa la estructura que finalmente se escribe en el archivo.
 * Contiene la cantidad de hijos que tiene el Nodo y la información de estos.
 */
struct Nodo{
    /// Cantidad de hijos que contiene el Nodo.
    int k;
    /// Arreglo que almacena a los hijos del nodo. Tiene tamaño fijo, así que hay que tener cuidado
    /// de no revisar más allá del índice Nodo.k - 1 o se accederá a basura.
    Hijo hijos[HIJOS_NODO]; // lugar donde se guardan hijos
    /// Relleno de bytes para completar el bloque.
    char pad[PAD_SIZE]; // cosa inútil para rellenar el bloque no más
};

#endif